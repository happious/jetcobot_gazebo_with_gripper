    <joint name="3_Joint" value="-0.349066" />
    <joint name="4_Joint" value="-1.39626" />
    <joint name="5_Joint" value="0" />
    <joint name="6_Joint" value="-0.7854" />
  </group_state>
  <group_state name="scan_left" group="arm_group">
    <joint name="1_Joint" value="1.5708" />
